{
  "version": 2,
  "regions": [
    "cdg1"
  ],
  "builds": [
    {
      "src": "app.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "50mb"
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "app.py"
    }
  ],
  "crons": [
    {
      "path": "/api/admin/email/cron/process",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/brand-pr/cron/waiting-emails",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/polly/cron/alerts",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/polly/cron/refresh-profiles",
      "schedule": "20 * * * *"
    },
    {
      "path": "/api/polly/cron/gifting-sweep",
      "schedule": "40 * * * *"
    },
    {
      "path": "/api/subscription/cron/billing-access",
      "schedule": "5 * * * *"
    }
  ],
  "git": {
    "deploymentEnabled": {
      "claude/*": false
    }
  }
}
