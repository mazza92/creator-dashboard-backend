# Copy relevant keys into your local .env (do not commit real secrets).

# --- TikTok Login Kit (OAuth Connect) ---
# Portal: https://developers.tiktok.com → your app → Login Kit + Display API
# 1. Add redirect URI exactly (Web requires https + a real host — not localhost):
#    https://api.newcollab.co/api/social/callback/tiktok
#    Local Connect still uses that URI; production bounces the unused code to
#    http://localhost:5000/api/social/callback/tiktok when return_url is local.
# 2. Request/approve scopes: user.info.basic, user.info.profile, user.info.stats, video.list
# 3. Copy Client Key + Client Secret below
# Leave TIKTOK_OAUTH_ENABLED unset in production until TikTok approves Login Kit.
# TIKTOK_OAUTH_ENABLED=1
# TIKTOK_CLIENT_KEY=
# TIKTOK_CLIENT_SECRET=
# TIKTOK_REDIRECT_URI=https://api.newcollab.co/api/social/callback/tiktok
# Fernet key for encrypting OAuth tokens at rest (python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
# SOCIAL_TOKEN_ENCRYPTION_KEY=
# FRONTEND_URL=https://app.newcollab.co

# --- Social scraping (in-house primary, Apify fallback) ---
# Required for production when Instagram rate-limits the server IP.
# APIFY_API_TOKEN=
# Optional actor overrides (defaults shown):
# APIFY_INSTAGRAM_ACTOR=apify~instagram-scraper
# APIFY_TIKTOK_ACTOR=clockworks~free-tiktok-scraper

# Optional but recommended for Instagram reliability when guest HTML is login-walled.
# Paste the `sessionid` cookie value from a logged-in instagram.com browser session.
# INSTAGRAM_SESSIONID=
# IG_SESSIONID=

# Absolute API origin for /api/media-proxy image URLs (required in production so
# app.newcollab.co never loads thumbs from the wrong host).
# PUBLIC_API_URL=https://api.newcollab.co

# --- Stripe: Brand Gifted UGC ($299/mo) ---
# Create a recurring Price in Stripe, then set:
# STRIPE_PRICE_ID_BRAND_GIFTED_MONTHLY=price_...
# Optional dedicated webhook endpoint → /api/brand-billing/webhook
# (falls back to STRIPE_WEBHOOK_SECRET_SUBSCRIPTION if unset)
# STRIPE_WEBHOOK_SECRET_BRAND=whsec_...

# Resend (creator campaigns). Use the same API key as lifecycle emails.
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=team@newcollab.co
# RESEND_FROM_NAME=Newcollab

# Gemini (post-scrape niche / aesthetic analysis)
GEMINI_API_KEY=
